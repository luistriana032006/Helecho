{
  "name": "helecho",
  "version": "1.0.4",
  "description": "Editor de apuntes matemáticos sin LaTeX",
  "homepage": "https://github.com/luistriana032006/Helecho",
  "author": {
    "name": "Luis Triana",
    "email": "luistriana617@gmail.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev -w -- --no-sandbox",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron --no-sandbox .",
    "package": "npm run build && electron-builder",
    "package:deb": "npm run build && electron-builder --linux deb",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:linux": "build/publish-linux.sh",
    "package:mac": "npm run build && electron-builder --mac --universal --publish never",
    "publish:mac": "npm run build && electron-builder --mac --universal --publish always",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.0",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-bold": "^2.27.2",
    "@tiptap/extension-bullet-list": "^2.27.2",
    "@tiptap/extension-document": "^2.27.2",
    "@tiptap/extension-dropcursor": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-history": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-list-item": "^2.27.2",
    "@tiptap/extension-ordered-list": "^2.27.2",
    "@tiptap/extension-paragraph": "^2.27.2",
    "@tiptap/extension-strike": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^2.27.2",
    "@tsparticles/engine": "^4.1.3",
    "@tsparticles/react": "^4.1.3",
    "@tsparticles/slim": "^4.1.3",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.45",
    "lucide-react": "^1.17.0",
    "mathjs": "^15.2.0",
    "mermaid": "^11.15.0",
    "plotly.js-basic-dist-min": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "co.helecho.app",
    "productName": "Helecho",
    "directories": {
      "output": "release"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "luistriana032006",
        "repo": "Helecho"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Luis Triana <luistriana617@gmail.com>"
    },
    "deb": {
      "afterInstall": "build/deb/after-install.sh"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Helecho permite que los sitios de videollamadas abiertos en Alexandria usen la cámara después de pedirte permiso.",
        "NSMicrophoneUsageDescription": "Helecho permite que los sitios de videollamadas abiertos en Alexandria usen el micrófono después de pedirte permiso."
      }
    }
  }
}
